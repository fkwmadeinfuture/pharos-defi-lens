# Pharos DeFi Lens - Environment Variables

# Pharos Testnet RPC URL (default works out of the box)
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com

# Optional: CoinGecko Pro API Key (free tier works without key, but has rate limits)
# Get one at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
